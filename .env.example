# NAMINA Studio: server-only administrative session and dynamic publication.
NAMANA_ADMIN_PASSWORD=
NAMANA_SESSION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project. The public key is designed for browser access; the service
# role is NEVER exposed via VITE_ variables or checked into source control.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL: read-only lookup of legacy public/clients/*.json when migrating.
# The token should have GitHub Contents: Read permission only.
# New database-backed clients do not need these settings.
NAMANA_GITHUB_REPO=PebisnisDigital/NAMINA
NAMANA_GITHUB_BRANCH=main
NAMANA_GITHUB_TOKEN=

# Media upload (if enabled), server-side credentials only.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
